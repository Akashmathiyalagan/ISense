# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Google Gemini API Key for Grounded Regulatory Neural Synthesis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional Fallback)
OPENAI_API_KEY=

# Optional: override the default path to the generated BIS catalogue CSV.
# Default: repository-root/docs/bis-standards/BIS_Published_Indian_Standards_Index.csv
# BIS_STANDARDS_CATALOGUE_CSV=

# Meta WhatsApp Cloud API Credentials
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v22.0

# Published Meta WhatsApp Flow ID (create/publish Flow in WhatsApp Manager)
WHATSAPP_PRODUCT_INTAKE_FLOW_ID=

# Dynamic WhatsApp Flow endpoint encryption (keep private key outside source control)
WHATSAPP_FLOW_PRIVATE_KEY_PATH=./secrets/whatsapp_flow_private.pem
# Public endpoint configured in Meta Flow metadata: https://YOUR_PUBLIC_HOST/api/whatsapp/flow

